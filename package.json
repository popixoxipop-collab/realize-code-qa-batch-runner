{
  "name": "realize-code-qa-batch-runner",
  "version": "0.2.0",
  "description": "Class-selectable, team-parallel and resumable runner for authorized RealiZe code-understanding QA.",
  "type": "module",
  "private": false,
  "bin": {
    "realize-batch": "bin/realize-batch.mjs",
    "realize-playwright": "bin/realize-playwright.mjs"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "batch": "node bin/realize-batch.mjs",
    "playwright:class": "node bin/realize-playwright.mjs",
    "test": "node --test test/*.test.mjs",
    "test:runner": "node --test test/realize_batch_runner.test.mjs",
    "check": "node --check bin/realize-batch.mjs && node --check bin/realize-playwright.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "playwright-core": "^1.62.1"
  }
}
